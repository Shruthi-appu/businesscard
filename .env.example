# Names and placeholders only. Copy to .env and replace every placeholder locally.
# Do not commit .env. Empty provider credentials select the mock adapter.

# --- Local processes ---
NODE_ENV=development
PORT=3001
WEB_PORT=3000
API_PROXY_ORIGIN=http://localhost:3001
PUBLIC_WEB_ORIGIN=http://localhost:3000
API_PUBLIC_ORIGIN=http://localhost:3001
COOKIE_SECURE=false

# --- Postgres (Compose). Contact data lives here. ---
POSTGRES_USER=softxu
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=softxu
DATABASE_URL=postgresql://softxu:replace-with-local-password@localhost:5432/softxu

# --- Redis (Compose). Rate limits only in this phase. Not the system of record. ---
REDIS_URL=redis://localhost:6379/0

# --- Access and refresh signing. Generate locally. Never reuse a placeholder. ---
JWT_ACCESS_SECRET=replace-with-a-random-string
JWT_REFRESH_SECRET=replace-with-a-different-random-string
JWT_ISSUER=softxu-local
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Auth rate limit. Fail closed when Redis is down. ---
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# --- Object storage. Empty access key or secret selects the in-memory mock. ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=softxu
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_KMS_KEY_ARN=

# --- Queue. Empty SQS_ENDPOINT selects the in-memory mock. ---
# ElasticMQ does not check credentials. Real AWS queues need real keys outside git.
SQS_ENDPOINT=
SQS_REGION=us-east-1
SQS_ACCESS_KEY_ID=
SQS_SECRET_ACCESS_KEY=
SQS_IMAGE_QUEUE_URL=http://localhost:9324/000000000000/image-processing
SQS_OCR_QUEUE_URL=http://localhost:9324/000000000000/ocr-extraction
SQS_EXPORT_QUEUE_URL=http://localhost:9324/000000000000/export
SQS_IMAGE_DLQ_URL=http://localhost:9324/000000000000/image-processing-dlq
SQS_OCR_DLQ_URL=http://localhost:9324/000000000000/ocr-extraction-dlq
SQS_EXPORT_DLQ_URL=http://localhost:9324/000000000000/export-dlq

# --- Worker (later phases). Local token only. ---
WORKER_AUTH_TOKEN=

# --- Identity. All four must be set before OIDC is attempted. Until then the routes return 501. ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# --- Adapters used by later phases. Empty or mock keeps the local path offline. ---
OCR_PROVIDER=mock
EXTRACTOR_PROVIDER=deterministic
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_FROM=
EMAIL_PROVIDER=
EMAIL_API_KEY=
GEOCODER_PROVIDER=
GEOCODER_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# --- Telemetry. Leave empty to log to stdout. ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# --- Optional local demo user. Seed runs only when SEED_DEMO=true. No default password. ---
SEED_DEMO=false
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_USER_DISPLAY_NAME=

# --- Later AWS deploy only. Not read in Phase 1. ---
AWS_REGION=
