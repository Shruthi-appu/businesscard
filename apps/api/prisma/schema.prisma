generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
  pending_deletion

  @@map("user_status")
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String?    @unique @db.Citext
  phoneE164        String?    @unique @map("phone_e164")
  passwordHash     String?    @map("password_hash")
  identityProvider String?    @map("identity_provider")
  identitySubject  String?    @map("identity_subject")
  status           UserStatus @default(active)
  role             UserRole   @default(user)
  deletionScheduledAt DateTime? @map("deletion_scheduled_at") @db.Timestamptz
  purgedAt         DateTime?  @map("purged_at") @db.Timestamptz
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  profile         UserProfile?
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  idempotencyKeys IdempotencyKey[]
  cards           BusinessCard[]
  tags            CardTag[]
  walletEntries   WalletEntry[]
  notes           ContactNote[]
  reminders       Reminder[]
  networkingEvents NetworkingEvent[]
  assets           CardAsset[]
  ocrJobs          OcrJob[]
  sharesSent       CardShare[]    @relation("ShareSender")
  shareClaims      ShareClaim[]
  snapshots        CardSnapshot[]
  exchangeSessions ExchangeSession[] @relation("ExchangeInitiator")
  exchangeParticipations ExchangeParticipant[]
  dataExports      DataExport[]

  @@unique([identityProvider, identitySubject])
  @@map("users")
}

model UserProfile {
  userId        String   @id @map("user_id") @db.Uuid
  displayName   String   @map("display_name")
  avatarAssetId String?  @map("avatar_asset_id") @db.Uuid
  locale        String?
  countryCode   String?  @map("country_code")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarAsset CardAsset? @relation(fields: [avatarAssetId], references: [id], onDelete: SetNull)

  @@map("user_profiles")
}

model RefreshToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  replacedById  String?   @unique @map("replaced_by_id") @db.Uuid
  userAgentHash String?   @map("user_agent_hash")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshRotation")

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  requestId    String?  @map("request_id")
  metadata     Json     @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

enum CardType {
  scanned
  created
  manual

  @@map("card_type")
}

enum CardStatus {
  draft
  active
  archived

  @@map("card_status")
}

enum CardVisibility {
  private
  unlisted
  public

  @@map("card_visibility")
}

enum ContactKind {
  name
  designation
  company
  phone
  email
  website

  @@map("contact_kind")
}

enum WhatsappState {
  unknown
  yes
  no

  @@map("whatsapp_state")
}

enum FieldSource {
  ocr
  user

  @@map("field_source")
}

enum WalletOrigin {
  owned
  received

  @@map("wallet_origin")
}

enum WalletSource {
  scanned
  created
  received_qr
  received_nearby
  received_nfc
  received_sms
  received_link
  received_email
  manual

  @@map("wallet_source")
}

enum ReminderStatus {
  scheduled
  done
  cancelled

  @@map("reminder_status")
}

enum HistoryEventType {
  saved
  exchanged
  shared
  note
  reminder_set
  exported

  @@map("history_event_type")
}

model BusinessCard {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId     String         @map("owner_user_id") @db.Uuid
  title           String
  cardType        CardType       @map("card_type")
  status          CardStatus     @default(active)
  visibility      CardVisibility @default(private)
  publicSlug      String?        @unique @map("public_slug")
  activeVersionId String?        @unique @map("active_version_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  owner         User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  activeVersion CardVersion?  @relation("ActiveCardVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions      CardVersion[] @relation("CardVersions")
  walletEntries WalletEntry[]
  sides         CardSide[]
  ocrJobs       OcrJob[]
  shares        CardShare[]
  snapshots     CardSnapshot[]
  exchangeSelections ExchangeParticipant[] @relation("ExchangeSelection")

  @@index([ownerUserId, updatedAt])
  @@map("business_cards")
}

model CardVersion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId          String   @map("card_id") @db.Uuid
  versionNumber   Int      @map("version_number")
  designConfig    Json?    @map("design_config") @db.JsonB
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  card          BusinessCard    @relation("CardVersions", fields: [cardId], references: [id], onDelete: Cascade)
  activeFor     BusinessCard?   @relation("ActiveCardVersion")
  contacts      CardContact[]
  socialLinks   CardSocialLink[]
  addresses     CardAddress[]
  shares        CardShare[]
  snapshots     CardSnapshot[]

  @@unique([cardId, versionNumber])
  @@map("card_versions")
}

model CardContact {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardVersionId    String        @map("card_version_id") @db.Uuid
  kind             ContactKind
  label            String?
  valueRaw         String        @map("value_raw")
  valueNormalized  String?       @map("value_normalized")
  whatsappState    WhatsappState @default(unknown) @map("whatsapp_state")
  isPrimary        Boolean       @default(false) @map("is_primary")
  isPublic         Boolean       @default(false) @map("is_public")
  confidence       Decimal?      @db.Decimal(5, 4)
  source           FieldSource   @default(user)
  verifiedAt       DateTime?     @map("verified_at") @db.Timestamptz
  ocrSpan          String?       @map("ocr_span")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  version CardVersion @relation(fields: [cardVersionId], references: [id], onDelete: Cascade)

  @@index([valueNormalized])
  @@map("card_contacts")
}

model CardSocialLink {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardVersionId String      @map("card_version_id") @db.Uuid
  platform      String
  url           String
  isPublic      Boolean     @default(false) @map("is_public")
  confidence    Decimal?    @db.Decimal(5, 4)
  source        FieldSource @default(user)
  verifiedAt    DateTime?   @map("verified_at") @db.Timestamptz
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  version CardVersion @relation(fields: [cardVersionId], references: [id], onDelete: Cascade)

  @@map("card_social_links")
}

model CardAddress {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardVersionId    String      @map("card_version_id") @db.Uuid
  formattedAddress String      @map("formatted_address")
  latitude         Decimal?    @db.Decimal(9, 6)
  longitude        Decimal?    @db.Decimal(9, 6)
  isPublic         Boolean     @default(false) @map("is_public")
  confidence       Decimal?    @db.Decimal(5, 4)
  source           FieldSource @default(user)
  verifiedAt       DateTime?   @map("verified_at") @db.Timestamptz
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  version CardVersion @relation(fields: [cardVersionId], references: [id], onDelete: Cascade)

  @@map("card_addresses")
}

model CardTag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  links CardTagLink[]

  @@unique([userId, name])
  @@map("card_tags")
}

model WalletEntry {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  origin            WalletOrigin
  cardId            String?      @map("card_id") @db.Uuid
  snapshotId        String?      @map("snapshot_id") @db.Uuid
  source            WalletSource
  exchangeSessionId String?      @map("exchange_session_id") @db.Uuid
  shareId           String?      @map("share_id") @db.Uuid
  isFavourite       Boolean      @default(false) @map("is_favourite")
  savedAt           DateTime     @default(now()) @map("saved_at") @db.Timestamptz
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  card     BusinessCard?     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  snapshot CardSnapshot?     @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  share    CardShare?        @relation(fields: [shareId], references: [id], onDelete: SetNull)
  exchangeSession ExchangeSession? @relation(fields: [exchangeSessionId], references: [id], onDelete: SetNull)
  claim    ShareClaim?
  tags     CardTagLink[]
  notes    ContactNote[]
  reminders Reminder[]
  events   NetworkingEvent[]

  @@index([userId, savedAt])
  @@index([userId, isFavourite])
  @@map("wallet_entries")
}

model CardTagLink {
  walletEntryId String   @map("wallet_entry_id") @db.Uuid
  tagId         String   @map("tag_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  walletEntry WalletEntry @relation(fields: [walletEntryId], references: [id], onDelete: Cascade)
  tag         CardTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([walletEntryId, tagId])
  @@map("card_tag_links")
}

model ContactNote {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  walletEntryId String   @map("wallet_entry_id") @db.Uuid
  body          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletEntry WalletEntry @relation(fields: [walletEntryId], references: [id], onDelete: Cascade)

  @@index([walletEntryId])
  @@map("contact_notes")
}

model Reminder {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  walletEntryId String         @map("wallet_entry_id") @db.Uuid
  remindAt      DateTime       @map("remind_at") @db.Timestamptz
  status        ReminderStatus @default(scheduled)
  note          String?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletEntry WalletEntry @relation(fields: [walletEntryId], references: [id], onDelete: Cascade)

  @@index([status, remindAt])
  @@map("reminders")
}

model NetworkingEvent {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  walletEntryId String           @map("wallet_entry_id") @db.Uuid
  eventType     HistoryEventType @map("event_type")
  occurredAt    DateTime         @default(now()) @map("occurred_at") @db.Timestamptz
  metadata      Json             @db.JsonB
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletEntry WalletEntry @relation(fields: [walletEntryId], references: [id], onDelete: Cascade)

  @@index([walletEntryId, occurredAt])
  @@map("networking_events")
}

enum AssetType {
  original
  enhanced
  thumbnail
  logo
  avatar
  export

  @@map("asset_type")
}

enum AssetStatus {
  pending
  stored

  @@map("asset_status")
}

enum CardSideName {
  front
  back

  @@map("card_side_name")
}

enum OcrJobStatus {
  queued
  processing_image
  processing_ocr
  needs_review
  completed
  failed
  cancelled

  @@map("ocr_job_status")
}

model CardAsset {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId    String      @map("owner_user_id") @db.Uuid
  s3Key          String      @unique @map("s3_key")
  assetType      AssetType   @map("asset_type")
  status         AssetStatus @default(pending)
  mimeType       String      @map("mime_type")
  byteSize       Int         @map("byte_size")
  checksumSha256 String      @map("checksum_sha256")
  width          Int?
  height         Int?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  owner            User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  profiles         UserProfile[]
  originalFor      CardSide[]    @relation("SideOriginal")
  enhancedFor      CardSide[]    @relation("SideEnhanced")
  thumbnailFor     CardSide[]    @relation("SideThumbnail")

  @@index([ownerUserId])
  @@map("card_assets")
}

model CardSide {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId             String       @map("card_id") @db.Uuid
  side               CardSideName
  originalAssetId    String       @map("original_asset_id") @db.Uuid
  enhancedAssetId    String?      @map("enhanced_asset_id") @db.Uuid
  thumbnailAssetId   String?      @map("thumbnail_asset_id") @db.Uuid
  cropQuad           Json?        @map("crop_quad") @db.JsonB
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  card           BusinessCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  originalAsset  CardAsset    @relation("SideOriginal", fields: [originalAssetId], references: [id], onDelete: Restrict)
  enhancedAsset  CardAsset?   @relation("SideEnhanced", fields: [enhancedAssetId], references: [id], onDelete: SetNull)
  thumbnailAsset CardAsset?   @relation("SideThumbnail", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)

  @@unique([cardId, side])
  @@map("card_sides")
}

model OcrJob {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId             String       @map("card_id") @db.Uuid
  ownerUserId        String       @map("owner_user_id") @db.Uuid
  status             OcrJobStatus @default(queued)
  imageProvider      String       @default("mock-image-v1") @map("image_provider")
  ocrProvider        String       @default("mock-ocr-v1") @map("ocr_provider")
  extractorProvider  String       @default("grounded-v1") @map("extractor_provider")
  attempt            Int          @default(0)
  draftVersion       Int          @default(1) @map("draft_version")
  errorCode          String?      @map("error_code")
  startedAt          DateTime?    @map("started_at") @db.Timestamptz
  completedAt        DateTime?    @map("completed_at") @db.Timestamptz
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  card    BusinessCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  owner   User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  results OcrResult[]

  @@index([status, createdAt])
  @@index([ownerUserId])
  @@map("ocr_jobs")
}

model OcrResult {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ocrJobId         String       @map("ocr_job_id") @db.Uuid
  side             CardSideName
  rawText          String       @map("raw_text")
  blocks           Json         @db.JsonB
  structuredResult Json         @map("structured_result") @db.JsonB
  confidence       Json         @db.JsonB
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  job OcrJob @relation(fields: [ocrJobId], references: [id], onDelete: Cascade)

  @@unique([ocrJobId, side])
  @@map("ocr_results")
}

model CardTemplate {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key               String
  version           Int
  name              String
  layout            String
  allowedColors     Json     @map("allowed_colors") @db.JsonB
  allowedTypeScales Json     @map("allowed_type_scales") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([key, version])
  @@map("card_templates")
}

model CardShare {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId             String    @map("card_id") @db.Uuid
  cardVersionId      String    @map("card_version_id") @db.Uuid
  senderUserId       String    @map("sender_user_id") @db.Uuid
  tokenHash          String    @unique @map("token_hash")
  recipientPhoneHash String?   @map("recipient_phone_hash")
  scope              Json      @db.JsonB
  pinHash            String?   @map("pin_hash")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz
  maxClaims          Int       @default(1) @map("max_claims")
  claimCount         Int       @default(0) @map("claim_count")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  card     BusinessCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  version  CardVersion  @relation(fields: [cardVersionId], references: [id], onDelete: Restrict)
  sender   User         @relation("ShareSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  claims   ShareClaim[]
  entries  WalletEntry[]

  @@index([cardId])
  @@index([senderUserId])
  @@map("card_shares")
}

model ShareClaim {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shareId         String   @map("share_id") @db.Uuid
  claimedByUserId String?  @map("claimed_by_user_id") @db.Uuid
  walletEntryId   String?  @unique @map("wallet_entry_id") @db.Uuid
  claimedAt       DateTime @default(now()) @map("claimed_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  share       CardShare    @relation(fields: [shareId], references: [id], onDelete: Cascade)
  claimedBy   User?        @relation(fields: [claimedByUserId], references: [id], onDelete: SetNull)
  walletEntry WalletEntry? @relation(fields: [walletEntryId], references: [id], onDelete: SetNull)

  @@index([shareId])
  @@map("share_claims")
}

model CardSnapshot {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceCardId    String   @map("source_card_id") @db.Uuid
  sourceVersionId String   @map("source_version_id") @db.Uuid
  ownerUserId     String   @map("owner_user_id") @db.Uuid
  capturedAt      DateTime @default(now()) @map("captured_at") @db.Timestamptz
  payload         Json     @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sourceCard    BusinessCard  @relation(fields: [sourceCardId], references: [id], onDelete: Restrict)
  sourceVersion CardVersion   @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  owner         User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  walletEntries WalletEntry[]

  @@index([ownerUserId])
  @@map("card_snapshots")
}

enum DataExportStatus {
  queued
  ready
  failed

  @@map("data_export_status")
}

model DataExport {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  status     DataExportStatus @default(queued)
  storageKey String?          @map("storage_key")
  byteSize   Int?             @map("byte_size")
  errorCode  String?          @map("error_code")
  readyAt    DateTime?        @map("ready_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("data_exports")
}

enum ExchangeStatus {
  open
  joined
  accepted
  declined
  expired
  failed

  @@map("exchange_status")
}

enum ExchangeMode {
  one_way
  mutual

  @@map("exchange_mode")
}

enum ExchangeMethod {
  qr
  ble
  nfc
  link

  @@map("exchange_method")
}

enum ExchangeConsent {
  pending
  accepted
  declined

  @@map("exchange_consent")
}

model ExchangeSession {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  initiatorUserId String         @map("initiator_user_id") @db.Uuid
  status          ExchangeStatus @default(open)
  mode            ExchangeMode
  method          ExchangeMethod
  codeHash        String         @unique @map("code_hash")
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz
  acceptedAt      DateTime?      @map("accepted_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  initiator    User                  @relation("ExchangeInitiator", fields: [initiatorUserId], references: [id], onDelete: Cascade)
  participants ExchangeParticipant[]
  entries      WalletEntry[]

  @@index([codeHash, expiresAt])
  @@map("exchange_sessions")
}

model ExchangeParticipant {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String          @map("session_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  selectedCardId String?         @map("selected_card_id") @db.Uuid
  consentStatus  ExchangeConsent @default(pending) @map("consent_status")
  consentedAt    DateTime?       @map("consented_at") @db.Timestamptz
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  session      ExchangeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedCard BusinessCard?   @relation("ExchangeSelection", fields: [selectedCardId], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("exchange_participants")
}
